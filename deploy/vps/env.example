# SwapArc VPS — copy this file to `/root/swaparc/.env` on the server.
# Paste the SAME values you already have in Vercel (Settings → Environment Variables).
# Do NOT set REDIS_URL to Railway. Docker Compose forces redis://redis:6379.

# Public hostname Caddy will get a HTTPS certificate for.
VPS_API_DOMAIN=api.swaparc.app

# 1 = API + cron only (first boot, while copying Redis from Railway)
# 0 = also run the live swap indexer (after migrate + after Railway indexer is stopped)
VPS_SKIP_INDEXER=1

# Required. Same CRON_SECRET as Vercel.
CRON_SECRET=

NODE_ENV=production
RECURRING_SERVER_EXECUTION_ENABLED=true

# REQUIRED since 2026-09: without CIRCLE_API_KEY every login/signup 500s
# ("Circle API key not configured") — this was the 2026-09-07 outage.
CIRCLE_API_KEY=

# REQUIRED in production: subscription activation is a webhook/admin endpoint.
# Without it /api/payments/subscription/activate returns 503 (fails closed).
SUBSCRIPTION_ADMIN_SECRET=

# Recommended: route recurring pool deposits through the capped automation
# contract only (no uncapped depositFor fallback).
# RECURRING_AUTOMATION_STRICT=true

# Recommended: fail the PrivPay relay closed when Redis/KV is unreachable.
# PRIVPAY_RELAY_REQUIRE_KV=1

# Owner auth is enforced by default. Only for local development:
# SWAPARC_ALLOW_UNAUTHENTICATED_OWNER=1

# --- copy the rest from Vercel (examples, not secrets) ---
# ARC_RPC_URL=
# ARC_RPC_URL_FALLBACK=
# PRIVACY_POOL_RELAYER_PRIVATE_KEY=
# PRIVPAY_RELAY_SERVER_SECRET=
# BLOB_READ_WRITE_TOKEN=
# MY_PK=            # deploy/gas-sponsor only — prefer NOT exposing on the API box
# CORS_ORIGINS=https://swaparc.app,https://www.swaparc.app
