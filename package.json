{
  "name": "swaparc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k \"node server.js\" \"vite\"",
    "dev:ui": "vite",
    "dev:api": "node server.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "indexer": "node scripts/liveSwapIndexer.js",
    "start:railway": "node scripts/railwayStart.mjs",
    "stats:count-swappers": "node scripts/countUniqueSwappers.js",
    "stats:backfill-swap-volume": "node scripts/backfillSwapVolumeFromChain.mjs",
    "stats:backfill-dump-swaps": "node scripts/backfillSwapVolumeFromChain.mjs --dump-only",
    "stats:backfill-quote-shards": "powershell -ExecutionPolicy Bypass -File scripts/launchVolumeQuoteShards.ps1",
    "stats:backfill-merge-shards": "node scripts/backfillSwapVolumeFromChain.mjs --merge-shards",
    "stats:backfill-apply-volume": "node scripts/backfillSwapVolumeFromChain.mjs --apply-only",
    "stats:backfill-reapply-profiles": "node scripts/backfillSwapVolumeFromChain.mjs --profiles-only",
    "deploy:stealth": "node scripts/deployStealthPayments.mjs",
    "deploy:pool": "node scripts/deployPrivacyPool.mjs",
    "deploy:recurring-automation": "node scripts/deployRecurringAutomation.mjs",
    "deploy:swap-pool": "node scripts/deploySwapPoolV2.mjs",
    "upgrade:swap-pool": "node scripts/upgradeSwapPoolV2.mjs",
    "seed:swap-pool": "node scripts/seedSwapPoolV2.mjs",
    "verify:swap-pool": "node scripts/verifySwapPoolV2.mjs",
    "privpay:deployer-address": "node scripts/printDeployerAddress.mjs",
    "bootstrap:privpay-env": "node scripts/bootstrapPrivpayEnv.mjs",
    "privpay:zk-artifacts": "node scripts/setupPrivpayZkArtifacts.mjs",
    "migrate:kv-redis": "node scripts/migrateRedisToRedis.mjs",
    "circuit:privpay:compile": "node scripts/compilePrivpayCircuit.mjs",
    "circuit:privpay:prove": "node scripts/privpayProveCli.mjs",
    "stats:sum-profile-volume": "node scripts/sumProfileSwapVolume.js",
    "stats:publish-landing": "node scripts/publishLandingStats.mjs",
    "stats:export-dune": "node --max-old-space-size=4096 scripts/exportDuneCsv.mjs",
    "stats:export-dune-db": "node scripts/exportDuneFromDb.mjs",
    "stats:export-dune-grant": "node --max-old-space-size=4096 scripts/exportDuneGrant.mjs",
    "stats:publish-dune": "node scripts/publishDune.mjs",
    "stats:fix-dune-queries": "node scripts/publishDune.mjs --queries-only",
    "stats:upload-dune-leaderboards": "node scripts/uploadDuneLeaderboards.mjs",
    "stats:export-dune-all-profiles": "node scripts/exportDuneAllProfiles.mjs",
    "stats:upload-dune-profiles": "node scripts/uploadDuneAllProfiles.mjs",
    "stats:sync-dune-weekly": "node scripts/syncDuneWeekly.mjs",
    "stats:requote-dune-v2": "node scripts/requoteDuneV2Swaps.mjs",
    "stats:refresh-dune-grant-summaries": "node scripts/refreshDuneGrantSummaries.mjs",
    "stats:upload-dune-grant-summaries": "node scripts/uploadDuneGrantSummaries.mjs",
    "stats:refresh-dune-pool-tvl": "node scripts/refreshDuneLpPoolTvl.mjs",
    "verify:rpc-fallback": "node scripts/verifyRpcFallbackFlows.mjs"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^10.1.0",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@noble/secp256k1": "^3.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/contracts-upgradeable": "^5.0.2",
    "@vercel/blob": "^0.27.3",
    "@vercel/kv": "^1.0.1",
    "@walletconnect/ethereum-provider": "^2.23.1",
    "@walletconnect/modal": "^2.7.0",
    "@zxing/browser": "^0.2.0",
    "circomlibjs": "^0.1.7",
    "dotenv": "^16.4.5",
    "ethers": "^6.15.0",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.10.1",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.10.1",
    "snarkjs": "^0.7.6",
    "solc": "^0.8.34"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^5.1.0",
    "buffer": "^6.0.3",
    "circomlib": "^2.0.5",
    "concurrently": "^9.2.1",
    "crypto-browserify": "^3.12.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "pngjs": "^7.0.0",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "vite": "^7.2.2"
  }
}
